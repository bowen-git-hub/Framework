 116:hal_bsp/hal/driver/remote/sbus_ht10a.c **** /**
 117:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @brief  将SBUS数据转换为统一遥控器格式
 118:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  hur: 统一遥控器句柄
 119:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  hsbus: SBUS句柄
 120:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  */
 121:hal_bsp/hal/driver/remote/sbus_ht10a.c **** void SBUS_To_UniRemote(UniRemote_HandleTypeDef* hur, const SBUS_HandleTypeDef* hsbus) {
 122:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (hur == NULL || hsbus == NULL) {
 123:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         return;
 124:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
 125:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 126:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     //  遥控信号是否丢失
 127:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     hur->frame_lost = hsbus->frame_lost;  // 丢失遥控信号
 128:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     //  遥控模块是否连接
 129:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (HAL_GetTick() - hsbus->last_update > 200) {
 130:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->frame_connected = false;
 131:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     } else {
 132:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->frame_connected = true;
 133:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
 134:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 135:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     hur->last_update = hsbus->last_update;
 136:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 137:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (hur->frame_connected && !hur->frame_lost) {
 138:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         // 转换成标准范围数据
 139:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->right_x = SBUS_To_RBUS_Range(hsbus->channels_raw[0]);  // 通道1: 右摇杆X
 140:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->right_y = SBUS_To_RBUS_Range(hsbus->channels_raw[1]);  // 通道2: 右摇杆Y
 141:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->left_y = SBUS_To_RBUS_Range(hsbus->channels_raw[2]);   // 通道3: 左摇杆Y
 142:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->left_x = SBUS_To_RBUS_Range(hsbus->channels_raw[3]);   // 通道4: 左摇杆X
 143:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 144:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         // 映射开关状态
 145:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_sound = SBUS_Map_RBUS_Switch(hsbus->channels_raw[4]);  // 通道5: 左1开关�
 146:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_pid = SBUS_Map_RBUS_Switch(hsbus->channels_raw[5]);    // 通道6: 右2开关�
 147:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_mode = SBUS_Map_RBUS_Switch(hsbus->channels_raw[6]);   // 通道7: 左2开关�
 148:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_power = SBUS_Map_RBUS_Switch(hsbus->channels_raw[7]);  // 通道8: 右1开关�
 149:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     } else {
 150:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         // 丢失信号时，将所有数据置零
 151:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->right_x = RBUS_CH_MID;
 152:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->right_y = RBUS_CH_MID;
ARM GAS  C:\Users\honor\AppData\Local\Temp\ccIr4Z5e.s 			page 12


 153:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->left_y = RBUS_CH_MID;
 154:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->left_x = RBUS_CH_MID;
 155:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_mode = RBUS_SWITCH_OFF;
 156:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_power = RBUS_SWITCH_OFF;
 157:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_pid = RBUS_SWITCH_OFF;
 158:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         hur->switch_sound = RBUS_SWITCH_OFF;
 159:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
 160:hal_bsp/hal/driver/remote/sbus_ht10a.c **** }
 161:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 162:hal_bsp/hal/driver/remote/sbus_ht10a.c **** /**
 163:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @brief  将SBUS原始值转换RBUS标准范围
 164:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  sbus_value: SBUS原始值 (192-1792)
