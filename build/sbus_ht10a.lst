  50:hal_bsp/hal/driver/remote/sbus_ht10a.c **** /**
  51:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @brief  更新SBUS数据
  52:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  hsbus: SBUS句柄
  53:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  data: 原始数据指针
  54:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  len: 数据长度
  55:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @retval 解析是否成功
  56:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  */
  57:hal_bsp/hal/driver/remote/sbus_ht10a.c **** bool SBUS_Update(SBUS_HandleTypeDef* hsbus, const uint8_t* data, uint32_t len) {
  58:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (hsbus == NULL || data == NULL || len != SBUS_FRAME_LENGTH) {
  59:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         return false;
  60:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
  61:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
  62:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     // 检查帧头和帧尾
  63:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (data[0] != SBUS_HEADER || data[SBUS_FRAME_LENGTH - 1] != SBUS_FOOTER) {
  64:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         return false;
  65:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
  66:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
  67:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     // 拷贝原始数据
  68:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     memcpy(&hsbus->raw_data, data, sizeof(SBUS_RawData));
  69:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
  70:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     // 解析通道数据
  71:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
  72:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     SBUS_ParseChannels(hsbus);
  73:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
  74:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     return true;
  75:hal_bsp/hal/driver/remote/sbus_ht10a.c **** }
