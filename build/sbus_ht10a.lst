 207:hal_bsp/hal/driver/remote/sbus_ht10a.c **** /**
 208:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @brief  打印通道数据（详细版）
 209:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  * @param  hsbus: SBUS句柄
 210:hal_bsp/hal/driver/remote/sbus_ht10a.c ****  */
 211:hal_bsp/hal/driver/remote/sbus_ht10a.c **** void SBUS_PrintChannels(const SBUS_HandleTypeDef* hsbus) {
 212:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (hsbus == NULL) {
 213:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         printf("SBUS: Invalid handle\n");
 214:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         return;
 215:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
 216:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 217:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     if (!SBUS_IsConnected(hsbus)) {
 218:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         printf("SBUS: Disconnected\n");
 219:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         return;
 220:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
 221:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 222:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     printf("=== SBUS All Channels ===\n");
 223:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     printf("Raw Values (0-2047):\n");
 224:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 225:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     // 打印原始值
 226:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     for (int i = 0; i < 16; i++) {
 227:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         printf("CH%2d: %4d", i + 1, hsbus->channels_raw[i]);
 228:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         if ((i + 1) % 4 == 0) {
 229:hal_bsp/hal/driver/remote/sbus_ht10a.c ****             printf("\n");
 230:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         } else {
 231:hal_bsp/hal/driver/remote/sbus_ht10a.c ****             printf(" | ");
ARM GAS  C:\Users\honor\AppData\Local\Temp\ccIr4Z5e.s 			page 20


 232:hal_bsp/hal/driver/remote/sbus_ht10a.c ****         }
 233:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     }
 234:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
 235:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     printf("Digital: CH17=%d, CH18=%d\n", hsbus->ch17, hsbus->ch18);
 236:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     printf("Status: Frame Lost=%d, Failsafe=%d\n", hsbus->frame_lost, hsbus->failsafe);
 237:hal_bsp/hal/driver/remote/sbus_ht10a.c ****     printf("Connection: %s, Last Update: %lu ms\n",
 238:hal_bsp/hal/driver/remote/sbus_ht10a.c ****            SBUS_IsConnected(hsbus) ? "OK" : "Lost", hsbus->last_update);
 239:hal_bsp/hal/driver/remote/sbus_ht10a.c **** }
 240:hal_bsp/hal/driver/remote/sbus_ht10a.c **** 
