 135:frameworks/f407/Core/Src/system_stm32f4xx.c ****                variable is updated automatically.
 136:frameworks/f407/Core/Src/system_stm32f4xx.c ****   */
 137:frameworks/f407/Core/Src/system_stm32f4xx.c **** uint32_t SystemCoreClock = 16000000;
