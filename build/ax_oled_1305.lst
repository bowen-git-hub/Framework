 101:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xF1);  // Set Pre-Charge as 15 Clocks & Discharge as 1 Clock
 102:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xDA);  //--set com pins hardware configuration
 103:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x12);
 104:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xDB);  //--set vcomh
 105:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x40);  // Set VCOM Deselect Level
 106:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x20);  //-Set Page Addressing Mode (0x00/0x01/0x02)
