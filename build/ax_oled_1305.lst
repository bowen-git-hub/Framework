  88:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x40);  //--set start line address  Set Mapping RAM Display Start Line (0x00~0x3F
  89:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x81);  //--set contrast control register
  90:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xEF);  // Set SEG Output Current Brightness
  91:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xA1);  //--Set SEG/Column Mapping     0xa0左右反置 0xa1正常
  92:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xC8);  // Set COM/Row Scan Direction   0xc0上下反置 0xc8正常
  93:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xA6);  //--set normal display
  94:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xA8);  //--set multiplex ratio(1 to 64)
  95:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x3f);  //--1/64 duty
  96:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xD3);  //-set display offset	Shift Mapping RAM Counter (0x00~0x3F)
  97:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x00);  //-not offset
  98:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0xd5);  //--set display clock divide ratio/oscillator frequency
  99:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     OLED_WriteCmd(0x80);  //--set divide ratio, Set Clock as 100 Frames/Sec
