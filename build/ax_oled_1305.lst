 117:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** /**
 118:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @简  述  OLED屏幕清除
 119:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @参  数  无
 120:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @返回值	 无
 121:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  */
 122:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** void AX_OLED_ClearScreen(void) {
 123:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     uint8_t i, n;
 124:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     for (i = 0; i < 8; i++) {
 125:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         OLED_WriteCmd(0xb0 + i);  // 设置页地址（0~7）
 126:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         OLED_WriteCmd(0x00);      // 设置显示位置—列低地址
 127:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         OLED_WriteCmd(0x10);      // 设置显示位置—列高地址
 128:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         for (n = 0; n < 128; n++)
 129:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_WriteData(0);
 130:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     }  // 更新显示
 131:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** }
 132:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 133:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** /**
 134:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @简  述  OLED指定位置显示一个ASCII字符（6X8）
 135:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @参  数  x：横坐标 0~123，超出范围不显示
 136:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  *          y：纵坐标 0~6，超出范围不显示
 137:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  *          ch：显示字符
 138:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  *          mode：显示模式，0-正常显示，1-反白显示
 139:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @返回值
 140:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  */
 141:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** void AX_OLED_DispChar(uint8_t x, uint8_t y, uint8_t ch, uint8_t mode) {
 142:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     uint8_t c = 0, i = 0;
 143:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 144:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     c = ch - ' ';  // 得到偏移后的值
ARM GAS  C:\Users\honor\AppData\Local\Temp\ccuWKR9G.s 			page 4


 145:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 146:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     // 显示范围控制，超出部分不显示
 147:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     if ((x < 123) && (y < 8)) {
 148:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         if (mode != 0) {
 149:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_Set_Pos(x, y);
 150:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             for (i = 0; i < 6; i++)
 151:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 OLED_WriteData(~ASCII6X8[c * 6 + i]);
 152:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         } else {
 153:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_Set_Pos(x, y);
 154:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             for (i = 0; i < 6; i++)
 155:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 OLED_WriteData(ASCII6X8[c * 6 + i]);
 156:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         }
 157:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     }
 158:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** }
 159:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 160:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** /**
 161:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @简  述  OLED指定位置显示ASCII字符串（8X16）,自动换行。
 162:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @参  数  x：横坐标 0~123，超出范围不显示
 163:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  *          y：纵坐标 0~7，超出范围不显示
 164:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  *          ch：字符串指针
 165:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  *          mode：显示模式，0-正常显示，1-反白显示
 166:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  * @返回值
 167:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****  */
 168:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** void AX_OLED_DispStr(uint8_t x, uint8_t y, uint8_t* ch, uint8_t mode) {
 169:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     uint8_t j = 0;
 170:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 171:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     if ((x < 123) && (y < 8)) {
 172:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         while (ch[j] != '\0') {
 173:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             AX_OLED_DispChar(x, y, ch[j], mode);
 174:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             x += 6;
 175:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 176:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             if (x > 122) {
 177:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 x = 0;
 178:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 y += 1;  // 当y>6时，超出部分不再显示
