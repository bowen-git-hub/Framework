 291:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** 
 292:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     // 显示范围控制，超出部分不显示
 293:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     if ((x < 121) && (y < 7)) {
 294:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         if (mode != 0) {
 295:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_Set_Pos(x, y);
 296:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             for (i = 0; i < 8; i++)
 297:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 OLED_WriteData(~ASCII8X16[c * 16 + i]);
 298:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_Set_Pos(x, y + 1);
 299:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             for (i = 0; i < 8; i++)
 300:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 OLED_WriteData(~ASCII8X16[c * 16 + i + 8]);
 301:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         } else {
 302:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_Set_Pos(x, y);
 303:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             for (i = 0; i < 8; i++)
 304:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 OLED_WriteData(ASCII8X16[c * 16 + i]);
 305:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             OLED_Set_Pos(x, y + 1);
 306:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****             for (i = 0; i < 8; i++)
 307:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****                 OLED_WriteData(ASCII8X16[c * 16 + i + 8]);
 308:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****         }
 309:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c ****     }
 310:hal_bsp/hal/driver/spi_oled/ax_oled_1305.c **** }
